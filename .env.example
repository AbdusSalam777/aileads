NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/ai_leads
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
LOG_LEVEL=info
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AUTH_COOKIE_DOMAIN=

# --- Public / general ---
# Must be publicly reachable in production so unsubscribe links work.
PUBLIC_BASE_URL=http://localhost:5000
SCHEDULER_ENABLED=false
TIMEZONE=UTC

# --- Dry run ---
# PIPELINE_DRY_RUN forces all three flags below to true.
PIPELINE_DRY_RUN=false
EMAIL_DRY_RUN=true
AI_DRY_RUN=false
DISCOVERY_DRY_RUN=false

# --- Discovery ---
DISCOVERY_DAILY_LEAD_TARGET=40
INTENT_SOURCES=hn,remoteok,wwr
# HN's freelancer thread is monthly and fills up in the first days of the month,
# so a short window throws away nearly every real request. 720h = 30 days.
INTENT_MAX_AGE_HOURS=720
# Sent in the User-Agent so operators of free services can contact you. Be a good citizen.
HTTP_CONTACT_EMAIL=

# --- Reddit (optional intent source: free app registration, no credit card) ---
# Create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- OpenStreetMap Overpass (fit-based backfill; donated public service, be gentle) ---
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
OVERPASS_MIN_INTERVAL_MS=10000
OVERPASS_TIMEOUT_MS=90000
OVERPASS_CACHE_TTL_HOURS=24
OVERPASS_MAX_RESULTS=200

# --- Scraper ---
SCRAPE_TIMEOUT_MS=10000
SCRAPE_MAX_BYTES=500000
SCRAPE_MAX_PAGES_PER_SITE=3
SCRAPE_MIN_INTERVAL_MS=3000
SCRAPE_USER_AGENT=ai-leads-outreach/0.1
ENRICH_BATCH_SIZE=10

# --- AI (free tier) ---
# groq  = free API key from https://console.groq.com (no credit card)
# ollama = fully local, no account at all
# stub   = deterministic fixtures, used by dry runs
AI_PROVIDER=groq
AI_MIN_INTERVAL_MS=3000
AI_MAX_RETRIES=3
AI_BATCH_SIZE=5
AI_TIMEOUT_MS=60000
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# --- Email / SMTP ---
# Works with any SMTP provider. SMTP_USER is the full email address.
#   Hostinger : smtp.hostinger.com : 465  (password = the mailbox password)
#   Gmail     : smtp.gmail.com     : 465  (password = an App Password; requires
#                                          2-Step Verification enabled first)
OUTREACH_ENABLED=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
EMAIL_DAILY_CAP=8
EMAIL_MIN_SPACING_MINUTES=45
EMAIL_MAX_SPACING_MINUTES=180
EMAIL_SEND_START_HOUR=9
EMAIL_SEND_END_HOUR=17
EMAIL_SEND_DAYS=1,2,3,4,5

# --- IMAP (reply + bounce detection; same credentials as SMTP) ---
#   Hostinger : imap.hostinger.com : 993
#   Gmail     : imap.gmail.com     : 993
IMAP_ENABLED=false
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_POLL_MINUTES=10
IMAP_MAX_STALE_HOURS=24

# --- Compliance (legally required before real sending) ---
UNSUBSCRIBE_SECRET=change-me-unsubscribe-secret-at-least-32-chars
SENDER_PHYSICAL_ADDRESS=
