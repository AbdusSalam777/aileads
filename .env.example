NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/ai_leads
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
LOG_LEVEL=info
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AUTH_COOKIE_DOMAIN=

# --- Public / general ---
# Must be publicly reachable in production so unsubscribe links work — this
# app never sends email itself, but every exported message still carries a
# link back here.
PUBLIC_BASE_URL=http://localhost:5000
SCHEDULER_ENABLED=false
TIMEZONE=UTC

# --- Dry run ---
# PIPELINE_DRY_RUN forces both flags below to true.
PIPELINE_DRY_RUN=false
AI_DRY_RUN=false
DISCOVERY_DRY_RUN=false

# --- Discovery ---
# No send cap to pace against any more — bounded by what a polite daily sweep
# of Overpass can return, not by how much you could mail out.
DISCOVERY_DAILY_LEAD_TARGET=300
INTENT_SOURCES=hn,remoteok,wwr
# HN's freelancer thread is monthly and fills up in the first days of the month,
# so a short window throws away nearly every real request. 720h = 30 days.
INTENT_MAX_AGE_HOURS=720
# Sent in the User-Agent so operators of free services can contact you. Be a good citizen.
HTTP_CONTACT_EMAIL=

# --- Reddit (optional intent source: free app registration, no credit card) ---
# Create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- OpenStreetMap Overpass (fit-based backfill; donated public service, be gentle) ---
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
OVERPASS_MIN_INTERVAL_MS=10000
OVERPASS_TIMEOUT_MS=90000
OVERPASS_CACHE_TTL_HOURS=24
# Raised alongside the daily target so a big city's results are not truncated.
OVERPASS_MAX_RESULTS=400

# --- Scraper ---
SCRAPE_TIMEOUT_MS=10000
SCRAPE_MAX_BYTES=500000
# More contact/about pages visited per site directly raises the share of leads
# that come back with a usable email address.
SCRAPE_MAX_PAGES_PER_SITE=5
SCRAPE_MIN_INTERVAL_MS=3000
SCRAPE_USER_AGENT=ai-leads-outreach/0.1
ENRICH_BATCH_SIZE=20

# --- AI (free tier) ---
# groq  = free API key from https://console.groq.com (no credit card)
# ollama = fully local, no account at all
# stub   = deterministic fixtures, used by dry runs
AI_PROVIDER=groq
AI_MIN_INTERVAL_MS=3000
AI_MAX_RETRIES=3
AI_BATCH_SIZE=10
AI_TIMEOUT_MS=60000
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# --- IMAP (reply detection only) ---
# This app has no SMTP sending of its own — leads are exported as JSON and sent
# from wherever the operator pastes them. IMAP just watches for replies to
# whatever address that outreach actually goes out from, so reply rate and
# "who replied" still show up here.
#   Hostinger : imap.hostinger.com : 993
#   Gmail     : imap.gmail.com     : 993
IMAP_ENABLED=false
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_POLL_MINUTES=10
IMAP_MAX_STALE_HOURS=24

# --- Compliance (legally required — appears in every exported email) ---
UNSUBSCRIBE_SECRET=change-me-unsubscribe-secret-at-least-32-chars
SENDER_PHYSICAL_ADDRESS=
